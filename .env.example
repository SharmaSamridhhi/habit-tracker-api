# Copy this file to .env and adjust values for your machine.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma.
# Matches the `db` service in docker-compose.yml by default. Host port 5434
# is used (instead of 5432) to avoid clashing with a locally-installed Postgres.
DATABASE_URL="postgresql://habit_user:habit_pass@localhost:5434/habit_tracker?schema=public"

# Secret used to sign JWTs. Use a long, random value in real deployments.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# bcryptjs cost factor.
BCRYPT_SALT_ROUNDS=10

# Per-user rate limiting (habit routes).
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=100
